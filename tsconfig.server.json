// Emits the server to plain JS for the Docker image. Type-checking itself
// still runs through the root tsconfig.json (`pnpm typecheck`); this config
// only exists to produce dist/server for `node` to run.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    // source imports say `./render-readme.ts` (Node's own ESM rule, and what
    // the root tsconfig's allowImportingTsExtensions is there for); emitting
    // rewrites those to `.js` so the compiled output actually resolves.
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/server",
    "rootDir": "src/server"
  },
  "include": ["src/server"]
}
